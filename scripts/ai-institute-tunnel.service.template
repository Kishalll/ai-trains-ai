[Unit]
Description=Public HTTPS Tunnel for AI-Institute API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/path/to/ai-institute
ExecStart=/path/to/.venv/bin/python /path/to/ai-institute/scripts/tunnel.py --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
